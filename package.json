{
  "name": "mishkontin-heroes",
  "private": true,
  "version": "0.2.0",
  "description": "Мишконтин и кралят плъх Мортис — приказна стратегия в стил Heroes of Might and Magic III (концепция)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "balance": "vitest run tests/balance.test.ts --reporter=verbose",
    "build:single": "tsc --noEmit && node scripts/build-single.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
